ADMIN_PASSWORD=admin_pass
# Optional: fixed secret keeps admin logins alive across restarts (any long random string, for example openssl rand -hex 32)
SESSION_SECRET=session_secret
# Optional: admin session length in hours (default 12)
# SESSION_HOURS=12
# Time zone used to calculate 'start + duration' (month arithmetic)
TZ=Europe/Minsk
# HTTPS with the bundled Caddy (docker compose --profile https up -d): your domain, pointing at this server
# DOMAIN=timers.example.com
# TRUST_PROXY=1
# HTTP_BIND=127.0.0.1
# Or HTTPS served by the app itself: PEM certificate and key paths inside the container, and an optional redirect port
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem
# HTTP_PORT=8080
